# Delivery Service configuration
PORT=8084
LOG_LEVEL=info

# Dedicated MongoDB (delivery-db container in docker-compose.yml)
MONGO_USER=delivery_user
MONGO_PASSWORD=YOUR_PASSWORD
# Used when running outside docker (compose overrides the host):
MONGODB_URI=mongodb://delivery_user:YOUR_PASSWORD@localhost:27017/delivery_db?authSource=admin

# Shared HS256 secret — MUST be identical to auth-service JWT_SECRET
JWT_SECRET=YOUR_SECRET_KEY_HERE
JWT_ISSUER=goodfood-auth
JWT_AUDIENCE=goodfood-api

# Shared secret of the internal APIs (order-service /internal/orders)
SERVICE_API_KEY=YOUR_SERVICE_KEY

# order-service root URL (internal API, service key)
ORDER_SERVICE_URL=http://localhost:8082
# franchise-service root URL (restaurant address and GPS position)
FRANCHISE_SERVICE_URL=http://localhost:8089

# RabbitMQ (order.ready_for_pickup, order.cancelled). Empty = consumer disabled.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# Safety-net reconciliation with order-service (ms, 0 = off)
RECONCILE_INTERVAL_MS=60000

# Shares Socket.IO rooms between replicas (required with more than one replica)
REDIS_URL=
# Couriers farther than this from the restaurant get no push (km)
PUSH_RADIUS_KM=8
