# Delivery Service configuration
PORT=8084
LOG_LEVEL=info

# Dedicated MongoDB (delivery-db container in docker-compose.yml)
MONGO_USER=delivery_user
MONGO_PASSWORD=YOUR_PASSWORD
# Used when running outside docker (compose overrides the host):
MONGODB_URI=mongodb://delivery_user:YOUR_PASSWORD@localhost:27017/delivery_db?authSource=admin

# Shared HS256 secret — MUST be identical to auth-service JWT_SECRET
JWT_SECRET=YOUR_SECRET_KEY_HERE

# order-service base URL (sync REST, courier token forwarded)
ORDER_SERVICE_URL=http://localhost:8082
